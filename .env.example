# Copy to `.env` and fill in. NEVER commit `.env` (it holds real secrets).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/seo_saas
BACKEND_CORS_ORIGINS=http://localhost:3000
PROJECT_NAME=SEO SaaS API
API_V1_PREFIX=/api

# JWT — generate a strong random secret for production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Google PageSpeed Insights API key (optional; PSI works keyless but rate-limited).
PSI_API_KEY=

# Google Search Console OAuth (optional). Create an OAuth 2.0 Web-application client
# in Google Cloud Console with the Search Console API enabled, and register
# http://localhost:8000/api/gsc/callback as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gsc/callback
FRONTEND_URL=http://localhost:3000

# Google Ads Keyword Planner (real volume, competition, CPC). Free Google API.
# Developer tokens were SUNSET 2026-09-09 — no token needed; access is tied to the
# Cloud project behind the OAuth client. To enable:
#   CLIENT_ID/SECRET: OAuth 2.0 Web client from a Cloud project with the Google Ads
#                     API enabled (leave blank to reuse the GSC client above).
#   REFRESH_TOKEN:    OAuth flow with scope https://www.googleapis.com/auth/adwords
#   CUSTOMER_ID:      your Ads account id, digits only (no dashes)
# The Ads account must be ENABLED (add a billing profile) and the Cloud project needs
# BASIC access (brand verification) for Keyword Planner on production accounts.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: set only if the account sits under a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Manual SERP scraper proxies (optional). Comma-separated Webshare-style
# host:port:user:pass entries; the scraper rotates through them. Leave empty to
# scrape from your own IP. NOTE: datacenter proxies are usually blocked/decoyed
# by search engines — use residential proxies for reliable results.
# SERP_PROXIES=host:port:user:pass,host2:port2:user2:pass2
SERP_PROXIES=

# AI Search (Claude). Without a key, AI Search returns a labelled sample response.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Stripe billing (optional). Without keys, plan selection works locally (1-year trial).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
TRIAL_DAYS=365

# Local AI via Ollama (content optimization). Free + private; falls back to a sample.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_ENABLED=True

# DataForSEO (legacy/optional keyword provider). Leave blank to disable.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── DataForSEO (SERP + keyword volume). Unset => sample/labelled data. ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── OpenAI (AI "find competitors" by domain). Unset => feature returns 503. ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local DB backup directory (used by scripts/backup_db.py)
DB_BACKUP_DIR=db_backup

# Environment + DataForSEO Sandbox (https://docs.dataforseo.com/v3/appendix/sandbox/)
# APP_ENV=development allows sandbox workspaces (free dummy data, same
# credentials); APP_ENV=production blocks them unless DATAFORSEO_SANDBOX_ENABLED=true.
# Sandbox workspaces' SERP/analytics rows are tagged environment='sandbox' and
# never appear in live workspaces. DATAFORSEO_FORCE_SANDBOX=true routes EVERY
# call to the sandbox (tests/CI) so nothing is charged.
APP_ENV=development
# DATAFORSEO_SANDBOX_ENABLED=
DATAFORSEO_FORCE_SANDBOX=false

# Ranked keywords (DataForSEO Labs, ~$0.01/call + $0.0001/keyword). Empty allowlist = any domain.
DATAFORSEO_LIVE_RANKED_TARGETS=
DATAFORSEO_RANKED_KEYWORDS_LIMIT=100
DATAFORSEO_RANKED_KEYWORDS_MAX_LIMIT=200

# Kill switch for the paid live API (false = refuse every live call).
DATAFORSEO_LIVE_ENABLED=true
